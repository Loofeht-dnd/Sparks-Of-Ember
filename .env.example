# Optional: bake a default API key into your build so this specific deploy
# never shows the "connect your AI" screen — meant for a SOLO, PERSONAL
# deployment only (e.g. just for your own phone).
#
# HOW THIS WORKS: Vite reads a file named exactly ".env" (not ".env.example")
# at build time and compiles anything prefixed VITE_ into the JS bundle your
# browser downloads. There's no backend in this project, so there's no way
# to keep a key truly secret from the browser — this just skips having to
# paste it in on first launch.
#
# SECURITY: anyone who has the URL of a deploy built with this can open dev
# tools and read the key straight out of the network requests. Fine for a
# link only you use. NOT fine if you share that URL, or if this .env file
# (unlike .env.example) ever ends up committed to a public repo — it's
# already gitignored, keep it that way.
#
# TO USE: copy this file to ".env" in the same folder, fill in a real key
# below, then run `npm run build` (or `npm run dev`) again.

VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=

# Points the game at a deployed shared-AI proxy Worker (see the separate
# ember-proxy-worker project) instead of/alongside the keys above. When set,
# the game skips the "connect your AI" screen entirely — no key needed at
# all, not even a build-time one. This is a URL, not a secret; it's fine for
# it to end up in the deployed bundle (that's the whole point — it's public
# by nature, same as any API endpoint).
VITE_PROXY_URL=
